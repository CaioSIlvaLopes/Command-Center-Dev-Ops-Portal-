# Django Core Settings
SECRET_KEY=django-insecure-command-center-dev-ops-portal-secret-key-2026
DEBUG=True
REQUIRE_AUTH=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.ngrok-free.app,.trycloudflare.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.ngrok-free.app,https://*.trycloudflare.com

# Database Configuration (PostgreSQL em producao / SQLite fallback em dev local)
# Exemplo PostgreSQL: postgres://postgres:postgres@localhost:5432/command_center
DATABASE_URL=sqlite:///db.sqlite3

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Webhooks & Integrations Security
WEBHOOK_SECRET_TOKEN=dev-secret-key
GITHUB_WEBHOOK_SECRET=

# Gemini Free Tier & Evolution API v2 (Phase 7 & 7.1)
GEMINI_API_KEY=
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Vault (Cofre de Credenciais & Acessos - Opcional, usa SECRET_KEY + SHA256 se vazio)
VAULT_ENCRYPTION_KEY=


